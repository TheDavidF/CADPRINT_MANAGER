# Backend generated artifacts
backend/target/
backend/*.log

# Runtime state and backups: keep out of public git history
backend/data/
*.mv.db
*.trace.db
*.db-journal
*.db.lock
*.sqlite
*.sqlite3

# Credentials and local overrides
.env
.env.*
!.env.example
*.local.properties

# Editor / OS temporary files
.DS_Store
Thumbs.db
*.swp
*.tmp
