{
  "name": "cadprint-manager-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write src vite.config.ts eslint.config.js *.json",
    "format:check": "prettier --check src vite.config.ts eslint.config.js *.json",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.10.1",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.1.0"
  }
}
